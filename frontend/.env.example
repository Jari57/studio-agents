# Public client configuration. Do not put backend secrets in this file or in
# any VITE_* variable: Vite exposes VITE_* values to the shipped application.
VITE_BACKEND_URL=
VITE_SENTRY_DSN=
VITE_APP_VERSION=

# Native in-app purchases stay disabled unless this exact flag is set to true
# and the platform-specific public RevenueCat SDK key is provided at build time.
# Do not enable until RevenueCat products, verified backend webhooks, and store
# entitlements have been tested in each platform's sandbox.
VITE_ENABLE_NATIVE_IAP=false
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=
