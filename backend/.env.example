# Studio Agents Backend - Environment Variables
# Copy this to .env and fill in your values

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Generative Model (defaults to a supported Gemini model)
GENERATIVE_MODEL=gemini-2.5-flash

# Optional: Stable Audio model for premium beat generation
# stable-audio-2.5 is the default and supports up to 3 minutes at 44.1 kHz stereo.
STABILITY_AUDIO_MODEL=stable-audio-2.5
STABILITY_API_KEY=your_stability_api_key_here

# Optional: Replicate API Token (for video generation)
REPLICATE_API_TOKEN=your_replicate_token_here

# Optional generation providers. At least one compatible provider is required
# for each asset type reported by GET /api/health.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
SUNO_API_KEY=your_suno_api_key_here
FAL_API_KEY=your_fal_api_key_here
UBERDUCK_API_KEY=your_uberduck_api_key_here
UBERDUCK_API_SECRET=your_uberduck_api_secret_here

# Production frontend origins (comma-free single origin used by CORS)
FRONTEND_URL=https://studioagentsai.com

# Optional: Stripe API Keys (for payments)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_CREATOR=price_creator_monthly
STRIPE_PRICE_STUDIO=price_studio_monthly
STRIPE_PRICE_LIFETIME=price_lifetime_one_time
STRIPE_PRICE_CREDITS_10=price_credits_10
STRIPE_PRICE_CREDITS_50=price_credits_50
STRIPE_PRICE_CREDITS_150=price_credits_150
STRIPE_PRICE_CREDITS_500=price_credits_500

# Optional: Firebase Admin SDK (for user management)
# Set these OR provide GOOGLE_APPLICATION_CREDENTIALS path
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Optional: Email Service (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Server Configuration
PORT=3000
NODE_ENV=production
