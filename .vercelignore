# Backend runtime is hosted on Railway, but Vercel's release gate installs and
# tests the backend before it publishes the frontend. Keep the backend source
# intact so its hardening scripts, tests, and service contracts are available.

# Infrastructure and local artifacts
/scripts/*
# The backend release gate executes this exact Docker transformation in an
# isolated fixture. Keep the test dependency in Vercel's uploaded build context.
!/scripts/patch-provider-routing.mjs
test-results/
railway.json
Procfile
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
*.md
!README.md

# Development files
.github/
.git/
.vscode/
.idea/

# Logs and temp files
logs/
*.log
*.tmp
*.temp

# Python artifacts (if any)
__pycache__/
*.py[cod]
*.whl
*.egg-info/

# Browser test artifacts
frontend/tests/*
# These dependency-free release contracts run in the production build.
# Keep browser-only specs/artifacts excluded, not the actual regression gate.
!frontend/tests/*.test.mjs
frontend/test-results/
frontend/playwright-report/
*.spec.js
*.spec.ts

# Build artifacts that should not be uploaded
node_modules/
.cache/

# Environment files
.env
.env.*
backend/.env

# Other deployment config files not needed by the Vercel frontend build
deploy-*.ps1
