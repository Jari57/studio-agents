# Backend runtime is hosted on Railway, but Vercel previews must receive the
# deterministic backend test inputs and patch script used by the release gate.
backend/*
!backend/package.json
!backend/package-lock.json
!backend/server.js
!backend/scripts/
!backend/scripts/**
!backend/services/
!backend/services/**
!backend/test/
!backend/test/**

# Infrastructure and local artifacts
/scripts/
test-results/
railway.json
Procfile
Dockerfile
docker-compose.yml
.dockerignore

# Documentation
*.md
!README.md

# Development files
.github/
.git/
.vscode/
.idea/

# Logs and temp files
logs/
*.log
*.tmp
*.temp

# Python artifacts (if any)
__pycache__/
*.py[cod]
*.whl
*.egg-info/

# Browser test artifacts
frontend/tests/
frontend/test-results/
frontend/playwright-report/
*.spec.js
*.spec.ts

# Build artifacts that should not be uploaded
node_modules/
.cache/

# Environment files
.env
.env.*
backend/.env

# Other deployment config files not needed by the Vercel frontend build
deploy-*.ps1